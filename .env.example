# 必填：Fernet 主密钥。生成方式：
# openssl rand -base64 32 | tr '+/' '-_'
SETTINGS_ENCRYPTION_KEY=

# 管理控制面密钥，至少 32 字符。轮换时先用逗号同时配置新旧 key，调用方切换后再移除旧 key。
ADMIN_API_KEYS=

# 可选调用方认证，格式：client_id:至少32字符密钥，多个以逗号分隔。
# 未配置时保留兼容模式，所有上传归入 legacy 调用方。
CLIENT_API_KEYS=

# 允许的 Storage Endpoint 主机、域名后缀或 CIDR，逗号分隔。
STORAGE_ENDPOINT_ALLOWLIST=.zos.ctyun.cn
ALLOW_INSECURE_STORAGE_HTTP=false

# 只绑定本机时保持 127.0.0.1；局域网部署改成服务器的实际内网 IP。
LISTEN_IP=127.0.0.1
LISTEN_PORT=8000

DATABASE_PATH=/data/db/zos-upload.db
TEMP_DIR=/data/tmp
APP_TIMEZONE=Asia/Shanghai
MAX_UPLOAD_BYTES=209715200
MAX_REQUEST_BODY_BYTES=213909504
MAX_CONCURRENT_UPLOADS=32
UPLOAD_RATE_LIMIT_PER_MINUTE=60
CLIENT_MAX_OBJECTS=10000
CLIENT_MAX_BYTES=1099511627776
TEMP_MIN_FREE_BYTES=1073741824
TASK_RETENTION_DAYS=180
LOG_RETENTION_DAYS=30
LOG_MAX_ROWS=100000
STALE_DELETE_SECONDS=900
RECOVERY_INITIAL_BUDGET_SECONDS=5
RECOVERY_BATCH_SIZE=25
RECOVERY_MAX_CONCURRENCY=4
RECOVERY_CONNECT_TIMEOUT_SECONDS=3
RECOVERY_READ_TIMEOUT_SECONDS=10
RECOVERY_MAX_ATTEMPTS=1
PROVIDER_CACHE_MAX_ENTRIES=128

# 默认通过 /dashboard/settings 首次配置；设为 true 时也会尝试读取下列 ZOS_* 变量。
BOOTSTRAP_STORAGE_FROM_ENV=true
# ZOS_ENDPOINT=
# ZOS_BUCKET=
# ZOS_PUBLIC_BASE_URL=
# ZOS_ACCESS_KEY=
# ZOS_SECRET_KEY=
# ZOS_CONNECT_TIMEOUT_SECONDS=5
# ZOS_READ_TIMEOUT_SECONDS=300
# ZOS_MAX_ATTEMPTS=2
# ZOS_VERIFY_TLS=true
# ENABLE_ZOS_BUCKET_METRICS=false
