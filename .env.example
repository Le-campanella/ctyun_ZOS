# 必填：Fernet 主密钥。生成方式：
# openssl rand -base64 32 | tr '+/' '-_'
SETTINGS_ENCRYPTION_KEY=

# 只绑定本机时保持 127.0.0.1；局域网部署改成服务器的实际内网 IP。
LISTEN_IP=127.0.0.1
LISTEN_PORT=8000

DATABASE_PATH=/data/db/zos-upload.db
TEMP_DIR=/data/tmp
APP_TIMEZONE=Asia/Shanghai
MAX_UPLOAD_BYTES=209715200
MAX_REQUEST_BODY_BYTES=213909504
MAX_CONCURRENT_UPLOADS=4
TEMP_MIN_FREE_BYTES=1073741824
TASK_RETENTION_DAYS=180
LOG_RETENTION_DAYS=30
LOG_MAX_ROWS=100000
STALE_DELETE_SECONDS=900

# 默认通过 /dashboard/settings 首次配置；设为 true 时也会尝试读取下列 ZOS_* 变量。
BOOTSTRAP_STORAGE_FROM_ENV=true
# ZOS_ENDPOINT=
# ZOS_BUCKET=
# ZOS_PUBLIC_BASE_URL=
# ZOS_ACCESS_KEY=
# ZOS_SECRET_KEY=
# ZOS_CONNECT_TIMEOUT_SECONDS=5
# ZOS_READ_TIMEOUT_SECONDS=300
# ZOS_MAX_ATTEMPTS=2
# ZOS_VERIFY_TLS=true
# ENABLE_ZOS_BUCKET_METRICS=false
