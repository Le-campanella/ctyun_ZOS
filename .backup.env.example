# 私有备份 Bucket；对象始终使用 private ACL。
BACKUP_ZOS_ENDPOINT=https://hangzhou7.zos.ctyun.cn
BACKUP_ZOS_BUCKET=fly-backup-buckets
BACKUP_ZOS_ACCESS_KEY=
BACKUP_ZOS_SECRET_KEY=

# 至少 32 个字符，必须独立于 SETTINGS_ENCRYPTION_KEY 并离线保存。
BACKUP_PASSPHRASE=
BACKUP_PREFIX=ctyun-zos-upload

# v1 备份格式会在内存中完成压缩与加密；超过上限时在读取前拒绝。
BACKUP_MAX_DATABASE_BYTES=536870912
BACKUP_MAX_BLOB_BYTES=805306368
